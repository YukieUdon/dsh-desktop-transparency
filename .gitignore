# Dependencies and build output
node_modules/
*.tgz

# The patched archive is a build product: ~121 MB, regenerated by apply.
*.asar
!test/fixtures/*.asar

# Local runs of the CLI / verification against a real installation
.artifacts/
*.log

# Editors and OS cruft
.DS_Store
Thumbs.db
.idea/
.vscode/

# Never commit a real installation's archive or credentials
*.asar.official.*
.cordis-local/
